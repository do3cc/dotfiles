[user]
	email = do3cc@patrick-gerken.de
	name = Patrick Gerken
	signingKey = ~/.ssh/id_ed25519.pub
[core]
	autocrlf = input
	whitespace = space-before-tab,trailing-space

[apply]
	whitespace = fix

[init]
	defaultBranch = main

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname
	gpgSign = true

[diff]
	tool = nvimdiff
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true

[merge]
	tool = nvimdiff
	conflictStyle = zdiff3

[commit]
	template = ~/.config/git/message.txt
	verbose = true
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[alias]
	ai = add -i
	ap = add -p
	b = branch -a
	br = branch
	cf = config
	ci = commit
	cia = commit -a
	cam = commit -a -m
	co = checkout
	cp = cherry-pick
	d = diff
	dc = diff --cached
	dw = diff --color-words
	dwc = diff --cached --color-words
	lf = log --follow
	llf = log -p --follow
	l = log
	ll = log -p
	pp = !"echo 'Pull'; git pull; echo 'Push'; git push"
	resh1 = reset HEAD^
	s = !git --no-pager status
	sm = submodule
	st = status
	tl = tag -l
	copr = "!f() { git fetch -fu ${2:-origin} refs/pull/$1/head:pr/$1 && git checkout pr/$1; }; f"
	wtlist = worktree list
	wtprune = worktree prune
	wtadd = worktree add
	wtremove = worktree remove

[fetch]
	prune = true

[transfer]
	fsckObjects = true

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[credential]
	helper = /usr/lib/git-core/git-credential-libsecret
